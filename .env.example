# Supabase connection (public values — the anon key is safe to expose; RLS enforces access).
# NOTE: src/integrations/supabase/client.ts currently hardcodes these, so a local .env
# is optional today. Kept here as the forward pattern for when client.ts switches to
# import.meta.env.*. In DigitalOcean these are set as BUILD_TIME env vars (see .do/app.yaml).
VITE_SUPABASE_URL="https://pftqjrmdksrrpczhomln.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<supabase anon/publishable key>"

# Web-push PUBLIC VAPID key (public by design — the browser subscribes with it).
# The matching PRIVATE key is an Edge Function secret, never a VITE_ var.
VITE_VAPID_PUBLIC_KEY="<vapid public key>"
